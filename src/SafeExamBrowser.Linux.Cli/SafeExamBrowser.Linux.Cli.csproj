<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SafeExamBrowser.Linux.Client\SafeExamBrowser.Linux.Client.csproj" />
    <ProjectReference Include="..\SafeExamBrowser.Linux.Configuration\SafeExamBrowser.Linux.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SafeExamBrowser.Linux.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SafeExamBrowser</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- The Windows build is a GUI application (no console window): the browser is
       the user interface, exactly like the upstream client. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

</Project>
