<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>originatorVersion</key>
    <string>SEB_Linux_E2E</string>
    <key>sebMode</key>
    <integer>1</integer>
    <key>sebServerURL</key>
    <string>http://127.0.0.1:8765</string>
    <key>apiDiscovery</key>
    <string>/exam-api/discovery</string>
    <key>clientName</key>
    <string>e2e-client</string>
    <key>clientSecret</key>
    <string>e2e-secret</string>
    <key>exam</key>
    <string>1</string>
    <key>pingInterval</key>
    <integer>1000</integer>
  </dict>
</plist>
