<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The build version is part of the browser exam key and the SEB user agent /
         JavaScript API version and must not change per commit. -->
    <Version>3.10.2</Version>
    <FileVersion>3.10.2.920</FileVersion>
    <AssemblyVersion>3.10.2.0</AssemblyVersion>
    <Authors>ETH Zürich, IT Services</Authors>
    <Company>ETH Zürich, IT Services</Company>
    <Product>Safe Exam Browser</Product>
    <AssemblyTitle>Safe Exam Browser</AssemblyTitle>
    <FileDescription>Safe Exam Browser</FileDescription>
    <Description>Safe Exam Browser</Description>
    <RepositoryType>git</RepositoryType>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
